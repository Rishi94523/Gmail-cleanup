{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inboxclean",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "assets": { "directory": "./web/dist", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true }
}
