PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
SERVE_LANDING=true
# Hackathon edition: repeat manual runs and daily cleanup, up to 100 Primary emails/run.
HACKATHON_MODE=true
# Enable Gmail API; create a Google OAuth Web application client.
# Redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# npm run setup generates this once. Keep it stable to preserve saved account data.
TOKEN_ENCRYPTION_KEY=
# Optional locally (SQLite fallback). Required for shared/cloud deployment.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# NVIDIA model served by Nebius Token Factory. No alternate provider fallback.
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL
# Local daily timer works while npm start is running.
ENABLE_LOCAL_SCHEDULER=true
# Cloud Run: set this to the dedicated Cloud Scheduler service account email.
SCHEDULER_SERVICE_ACCOUNT=
