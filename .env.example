PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
# Create a Web application OAuth client in Google Cloud; enable Gmail API.
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Neon pulls these into the ignored local environment file.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
ENABLE_LOCAL_SCHEDULER=true
# AI provider: nebius or openrouter. Switching requires consent in Preferences.
# Preference discovery shares sender/subject samples after opt-in;
# autonomous decisions also share capped text (12,000 characters), never attachments.
AI_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Legacy AI_API_KEY / AI_MODEL remain supported for OpenRouter only.
