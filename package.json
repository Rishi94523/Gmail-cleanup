{
  "name": "inboxclean",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run check:web && npm run build:web && node --check server/index.js && node --check server/service.js && node --check server/postgres-store.js && node --check server/agent.js && node --check server/ai.js && node --check server/learning.js && node --check server/email-context.js && node --check server/subscription-agent.js && node --check public/app.js && node --check public/onboarding.js && node --check public/preference-answer.js",
    "ai:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-ai.mjs",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "build:web": "vite build --config web/vite.config.ts",
    "check:web": "tsc -p web/tsconfig.json",
    "start:preview": "node server/preview.js",
    "setup": "node scripts/setup.mjs",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.js",
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --watch server/index.js",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
