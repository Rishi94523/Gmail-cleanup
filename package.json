{
  "name": "inboxclean",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run check:web && npm run build:web && npm run lint",
    "lint": "eslint .",
    "ai:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-ai.mjs",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "build:web": "vite build --config web/vite.config.ts",
    "check:web": "tsc -p web/tsconfig.json",
    "setup": "node scripts/setup.mjs",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.js",
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "qa:landing": "node scripts/qa-landing.mjs",
    "qa:agent": "node scripts/qa-agent.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "google-auth-library": "^11.3.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
